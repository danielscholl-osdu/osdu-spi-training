   "x": 116,
   "y": 1040,
   "width": 780,
   "height": 16,
   "text": "What a bead carried: the note lines a Keelson run wrote on fn-m7u (14 Sep)",
   "originalText": "What a bead carried: the note lines a Keelson run wrote on fn-m7u (14 Sep)",
   "fontSize": 12,
